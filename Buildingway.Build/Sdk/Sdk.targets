<Project>
  <!-- Imported near the end of each project that adds <Sdk Name="Buildingway.Build" />, after the
       project's own body, so properties the project sets are already known here. -->

  <!-- A test project's GC heap is capped at 1 GiB. A mutant that stops a loop index advancing
       while the body still adds to a list or StringBuilder grows its test host by gigabytes before
       Stryker's timeout fires, and four such hosts at once had a full mutation run OOM-killed under
       a 6 GB cap. With the cap the host throws OutOfMemoryException within seconds, so the mutant
       is killed rather than timing out and memory stays bounded. Test suites need far less: Jaunt's
       2600 tests peak near 200 MB. A project sets TestHostHeapHardLimit to a byte count to raise
       the cap, or to 0 to remove it. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <TestHostHeapHardLimit Condition="'$(TestHostHeapHardLimit)' == ''">1073741824</TestHostHeapHardLimit>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(TestHostHeapHardLimit)' != '0'">
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="$(TestHostHeapHardLimit)" />
  </ItemGroup>
</Project>
